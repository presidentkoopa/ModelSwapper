// TOP LEVEL, not nested. This sits directly in Options as a peer of
// "Radiant Silvergun Options" rather than inside it -- the swapper works
// standalone next to any mod, so burying it under one particular mod's
// page would be wrong even when that mod is loaded.
//
// AddOptionMenu APPENDS rather than replaces, so whatever we are loaded
// next to keeps its own options page intact.

AddOptionMenu "OptionsMenu"
{
    StaticText " "
    Submenu "Weapon Model Swap Program", "RSFM_Main"
}

OptionMenu "RSFM_Main"
{
    Title "Weapon Model Swap Program"
    StaticText " "
    StaticText "Puts our 3D weapon models onto weapons from any mod", "DarkGray"
    StaticText "loaded alongside. Their code, damage and sounds stay", "DarkGray"
    StaticText "theirs -- only the gun in your hands is ours.", "DarkGray"
    StaticText " "

    Option "Enable", "rs_foreignmodels", "OnOff"
    StaticText " "

    Option "Models on Floor Pickups", "rs_foreignmodels_pickups", "OnOff"
    StaticText "ON: a weapon lying on the floor wears the same model you", "DarkGray"
    StaticText "will be holding once you pick it up, sized from the mesh", "DarkGray"
    StaticText "itself rather than by eye.", "DarkGray"
    StaticText "OFF: pickups stay exactly the sprites your mod drew. Some", "DarkGray"
    StaticText "mods have art worth keeping, and a hand-drawn pickup can", "DarkGray"
    StaticText "read better at a distance than a small 3D one.", "DarkGray"
    StaticText "Takes effect immediately -- no rescan, no map change.", "DarkGray"
    StaticText " "

    Slider "Muzzle Flash Opacity", "r_hudflatoverlay", 0.0, 1.0, 0.05, 2
    StaticText "A muzzle flash is a separate FLAT sprite, drawn by the weapon", "DarkGray"
    StaticText "on its own layer. Beside a 3D model it hangs in the air like a", "DarkGray"
    StaticText "billboard. 0 hides it, 1 leaves the mod exactly as drawn.", "DarkGray"
    StaticText "Only ever affects a weapon wearing one of our models -- a mod's", "DarkGray"
    StaticText "own sprite weapons keep their flashes.", "DarkGray"
    StaticText "Engine setting: does nothing on the Quest build.", "DarkGray"
    StaticText " "

    Option "Only Weapons I'm Carrying", "rs_foreignmodels_carried", "OnOff"
    StaticText "Hides everything not in your inventory right now. Cuts the", "DarkGray"
    StaticText "list to what your character actually gets -- useful on mods", "DarkGray"
    StaticText "that ship several classes' worth of guns.", "DarkGray"
    StaticText " "

    Option "Offer Models to Modelled Weapons", "rs_foreignmodels_replaceown", "OnOff"
    StaticText "ON by default. The engine only tells us a weapon has a model", "DarkGray"
    StaticText "SOMEWHERE -- not whether it is the gun in your hands. Mods that", "DarkGray"
    StaticText "model only the pickup on the floor (Project Brutality) look the", "DarkGray"
    StaticText "same as ones with real first-person models, so skipping them", "DarkGray"
    StaticText "hid the weapons that needed us most.", "DarkGray"
    StaticText "OFF leaves any modelled weapon alone. Rescan after changing.", "DarkGray"
    StaticText " "

    Option "One Row Per Family", "rs_foreignmodels_byfamily", "OnOff"
    StaticText "ON: one row per weapon family -- one shotgun row, one smg", "DarkGray"
    StaticText "row. Most mods ship the same gun several times over (Brutal", "DarkGray"
    StaticText "Doom 22 lists 85 weapons, and most are the same guns in a", "DarkGray"
    StaticText "different mode), so this is on by default.", "DarkGray"
    StaticText "OFF: a row for every single weapon, to dress each one.", "DarkGray"
    StaticText " "

    Submenu "Choose Models", "RSFM_Picker"
    Submenu "Scan Report",   "RSFM_Report"
    StaticText " "

    Command  "Rescan Now", "netevent rs-fm-rescan"
    StaticText "Re-reads the loaded mod. Models you picked are kept.", "DarkGray"
    StaticText " "

    Command  "Randomize -- One-Handed", "netevent rs-fm-random-onehand"
    StaticText "Slaps a random pistol, revolver or smg model on every weapon", "DarkGray"
    StaticText "in the list -- a mixed, varied loadout in one press. Overwrites", "DarkGray"
    StaticText "any models you already picked.", "DarkGray"
    StaticText " "

    Command  "Assign All -- VanAlek", "netevent rs-fm-assign-set 0"
    Command  "Assign All -- Bv21",    "netevent rs-fm-assign-set 1"
    Command  "Assign All -- MeatG",   "netevent rs-fm-assign-set 2"
    Command  "Assign All -- BWolf",   "netevent rs-fm-assign-set 3"
    StaticText "One press: every weapon wears that set, keeping its family --", "DarkGray"
    StaticText "a shotgun gets that set's shotgun. Families the set has no", "DarkGray"
    StaticText "model for keep whatever they had. Overwrites your picks.", "DarkGray"
    StaticText " "

    Command  "Forget Saved Models", "netevent rs-fm-forget-picks"
    StaticText "Model choices are remembered per weapon, kept between sessions --", "DarkGray"
    StaticText "one archive shared across every mod you load. Clear it to go back", "DarkGray"
    StaticText "to auto-picked models everywhere.", "DarkGray"
    StaticText " "

    Option "List Unbound Weapons", "rs_foreignmodels_showall", "OnOff"
    StaticText "Shows weapon classes with no slot binding -- useful when a mod's", "DarkGray"
    StaticText "weapons are missing from the list. The Heretic, Hexen and Strife", "DarkGray"
    StaticText "arsenals are excluded outright and never appear either way.", "DarkGray"
    StaticText " "

    Submenu "Ballistics", "RSFM_Ballistic"
}

// Kept on its own page and off the main one on purpose. Everything else
// in this mod changes what you see; this changes what happens.
OptionMenu "RSFM_Ballistic"
{
    Title "Ballistics"
    StaticText " "
    StaticText "Turns the player's instant-hit weapons into rounds that", "DarkGray"
    StaticText "actually fly, with a glowing tracer. Their damage, range and", "DarkGray"
    StaticText "impact effects are unchanged -- the bullet just takes time to", "DarkGray"
    StaticText "arrive, so it can be led and dodged. Melee is left alone.", "DarkGray"
    StaticText " "
    StaticText "This alters how the loaded mod plays, not just how it looks.", "Brick"
    StaticText " "

    Option "Bullets Travel", "rs_fm_ballistic", "OnOff"
    Slider "Round Speed", "rs_fm_ballistic_speed", 10, 400, 10, 0
    StaticText "Map units per tic. Lower is easier to see and easier to", "DarkGray"
    StaticText "dodge; higher plays closer to the original hitscan.", "DarkGray"
    StaticText "Keep at 300+ with GunBonsai loaded -- below that it files", "DarkGray"
    StaticText "converted guns as projectile weapons and offers them the", "DarkGray"
    StaticText "wrong upgrades.", "DarkGray"
    StaticText " "

    Slider "Muzzle Trim", "rs_fm_muzzle", -20, 80, 1, 0
    StaticText "The engine fires from your hand -- it has no idea where a", "DarkGray"
    StaticText "barrel ends. Each weapon family already gets its own guess;", "DarkGray"
    StaticText "nudge this if rounds still leave from the grip, or from out", "DarkGray"
    StaticText "in front of the gun.", "DarkGray"
    StaticText " "
    StaticText "---------------------------------------------", "DarkGray"
    StaticText " "

    StaticText "Bullet Time X Compensation", "Gold"
    Option "Enable", "rs_fm_bt", "OnOff"
    Slider "Player Speed During Slowdown", "rs_fm_bt_scale", 0.0, 1.0, 0.05, 2
    StaticText "Does nothing unless Bullet Time X is loaded alongside.", "DarkGray"
    StaticText " "
    StaticText "0.0 -- you are exactly as slow as the monsters.", "DarkGray"
    StaticText "1.0 -- you move at normal speed while the world crawls.", "DarkGray"
    StaticText " "
    StaticText "1.0 is already the fastest Bullet Time X's own player-speed", "DarkGray"
    StaticText "setting can express -- their own cvar has no faster option,", "DarkGray"
    StaticText "so this is the true top of the range, not a compromise.", "DarkGray"
    StaticText " "
    StaticText "Defaults to 0.0 -- Bullet Time X's own out-of-the-box", "DarkGray"
    StaticText "behavior. Enabling this changes nothing by itself; move", "DarkGray"
    StaticText "the slider above 0.0 to actually give yourself an edge.", "DarkGray"
    StaticText " "
    StaticText "Turn this off before editing Bullet Time X's own player", "Brick"
    StaticText "speed settings, or this will overwrite them.", "Brick"
}

OptionMenu "RSFM_Picker"
{
    class RS_Menu_ForeignModels
    Title "Choose Models"
}

OptionMenu "RSFM_Report"
{
    class RS_Menu_ForeignReport
    Title "Scan Report"
}
