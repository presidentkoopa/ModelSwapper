// ===================================================================
// BD21 -- the complete Brutal Doom v21 weapon set, generated from BD's
// own per-weapon MODELDEFs by gen_bd21.ps1. This IS the Bv21 set. It
// replaced a 20-model, 72MB copy taken from RS_Main's re-export, which
// was the same lineage minus the axe, the boot, the Dragonslayer and
// every dual variant.
//
// A BD .def declares the same actor name several times, each block bound
// to a DIFFERENT mesh -- the gun, plus Boot.md3 for the kick and nade.md3
// for the grenade toss, selected at runtime by sprite name. Each block is
// therefore imported as its own model, named after its mesh.
// ===================================================================

Model MS_Shotgun
{
	Path "Models/Weapons/hud/RS_Weapon/VR_Shotgun"
	Model 0 "shotgun.md3"
	Skin 0 "WPN-SHTGUN.png"
	Scale 1.35 1.35 1.35
   FrameIndex SHTG A 0 0
   FrameIndex SHTG B 0 9999
}

Model MS_SuperShotgun
{
	Path "Models/Weapons/hud/RS_Weapon/VR_SuperShotgun"
	Model 0 "ssg.md3"
	Skin 0 "WPN-SSHTGUN.png"
	Scale 1.35 1.35 1.35
	// THE SPAWN FRAME, WHICH IS WHY A DROPPED SSG WAS INVISIBLE ON
	// ULTIMATE DOOM. Added 2026-08-08.
	//
	// VR_SuperShotgun spawns in the world as SGN2 A (RS_Shotgun-style
	// Spawn state, RS_SuperShotgun.zs), and SGN2A0 is a DOOM 2 lump --
	// verified absent from doom.wad and present in doom2.wad. The repo
	// so on doom.wad an SSG elite drop or pedestal fill had NO SPRITE
	// AND NO MODEL: an actor that ticks, is reachable and renders
	// nothing. Exactly the PSP1/BFP1/PLP1/RLP1 defect fixed earlier the
	// same day, in the one family that pass did not cover because its
	// spawn sprite EXISTS -- just not in every IWAD.
	//
	// Mapping it to the model rather than extracting SGN2 from the IWAD:
	// the other five sprite-backed families already render their own
	// mesh in the world (SHTG A, CHGG A, REVO A, RIFK A, SAWG A all have
	// instead of alone in showing a vanilla pickup graphic, and it costs
	// no IWAD art at all.
   FrameIndex SHT2 A 0 0
   FrameIndex SHT2 B 0 9999
}

