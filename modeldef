// ============================================================================
// ModelSwapper -- donor MODELDEF blocks.
//
// Anchored on STOCK DOOM sprites (PISG, SHTG, SHT2, CHGG, MISG, PLSG, BFGG,
// PUNG, SAWG) rather than the donors' own. The anchor's only job now is to
// make FindModelFrame resolve so we inherit this block's Path/Skin/Scale/
// Offset -- psp.ModelFrame picks the frame that actually draws. Using sprites
// every IWAD already has means this pk3 ships no sprite lumps at all.
//
// The single FrameIndex per block maps letter A to the RESTING frame, so the
// model is still correct if ModelFrame is ever left unset.
//
// Each block's owning class must exist as a real Actor (see zscript.txt).
// DO NOT subclass a donor: FindModelFrameRaw compares smff->type == ti as an
// exact class-pointer test, so a subclass inherits no model.
// ============================================================================

Model MS_Pistol
{
	Path "Models/Weapons/hud/RS_Weapon/VR_Pistol"
	Model 0 "pistolet.md3"
	Skin 0 "WPN-9mm.png"
	Scale 1.35 1.35 1.35
   FrameIndex PISG A 0 0
}

