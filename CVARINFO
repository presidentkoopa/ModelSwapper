// ModelSwapper cvars.
server bool rs_foreignmodels         = true;   // master switch
server bool rs_foreignmodels_dump    = false;  // dump the scan to console
server bool rs_foreignmodels_showall = false;  // include weapons with no slot binding

// Ignore learned timing and always play clips at their authored rate.
// Timing is locked after a few observations either way, so both settings are
// deterministic -- this one just prefers the animation's own pacing.
server bool rs_foreignmodels_natural = false;

// Learned sequence timings, packed as class:seq:duration:brightTic;...
// Written once per sequence when its timing locks. Clear it with the menu.
server string rs_fm_learned = "";

// Hitscan -> projectile conversion. Off by default, and the only setting
// here that changes how the loaded mod plays rather than how it looks.
server bool rs_fm_ballistic       = false;  // player hitscans become travelling rounds
server int  rs_fm_ballistic_speed = 90;     // map units per tic, clamped 10-400
